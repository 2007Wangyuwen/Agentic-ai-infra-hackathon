#!/usr/bin/env python3
"""AEC ISA Compiler: aec-cc — PTX → raw AEC instruction stream."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from aec_parser import parse_ptx
from aec_passes import lower_ptx, lower_immediates, run_opt_pipeline
from aec_schedule import schedule_instructions
from aec_regalloc import LinearScanAllocator
from aec_backend import resolve_branches, generate_binary, write_binary


def compile_ptx(input_path, output_path, opt_level=2, report_path=None):
    with open(input_path) as f:
        text = f.read()
    kernel = parse_ptx(text)
    ptx_count = sum(len(b.instructions) for b in kernel.cfg.blocks.values())

    instructions = kernel.all_instructions()
    instructions = lower_ptx(kernel, instructions)
    instructions = lower_immediates(instructions)
    instructions = run_opt_pipeline(instructions, opt_level)

    gemm_applied = any(
        inst.dst and inst.dst.name == "__gm_a__lo" for inst in instructions
    )
    if opt_level >= 2 and not gemm_applied:
        instructions = schedule_instructions(instructions)

    block_starts = resolve_branches(instructions)
    alloc = LinearScanAllocator()
    alloc.allocate(instructions)
    binary = generate_binary(instructions, alloc, block_starts)
    write_binary(binary, output_path)

    report = {
        "status": "ok",
        "input": input_path,
        "output": output_path,
        "opt_level": f"O{opt_level}",
        "num_ptx_instructions": ptx_count,
        "num_aec_instructions": len(binary),
        "num_basic_blocks": len(kernel.cfg.blocks),
        "num_virtual_registers": len(kernel.reg_types),
        "num_physical_registers": alloc.next_reg,
        "num_predicates": alloc.next_pred,
        "spills": {"loads": alloc.spill_loads, "stores": alloc.spill_stores},
        "passes": {
            "dce": opt_level >= 1,
            "const_prop": opt_level >= 1,
            "cse": opt_level >= 2,
            "gmem_load_cse": opt_level >= 2,
            "licm": opt_level >= 2,
            "scheduler": "list" if opt_level >= 2 else "none",
            "gemm_iv": opt_level >= 2,
            "merge_blocks": opt_level >= 2,
        },
        "warnings": [],
    }
    if report_path:
        with open(report_path, "w") as f:
            json.dump(report, f, indent=2)
    return report


if __name__ == "__main__":
    opt = 2
    inp = None
    out = None
    report = None
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-O"):
            try:
                opt = int(a[2:])
            except ValueError:
                pass
        elif a == "-o" and i + 1 < len(args):
            out = args[i + 1]
            i += 1
        elif a == "--report" and i + 1 < len(args):
            report = args[i + 1]
            i += 1
        elif not a.startswith("-"):
            inp = a
        i += 1
    if not inp or not out:
        sys.stderr.write(
            "Usage: aec-cc input.ptx [-O0|-O2|-O3] -o output.aecbin [--report compile_report.json]\n"
        )
        sys.exit(1)
    result = compile_ptx(inp, out, opt, report)
    sys.stderr.write(f"[aec-cc] {result['num_aec_instructions']} instructions -> {out}\n")
