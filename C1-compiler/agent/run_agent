#!/usr/bin/env python3
"""C1 Agent: auto optimization loop."""

import subprocess, json, os, sys, time

# 路径配置
COMPILER = os.path.join(os.path.dirname(__file__), "../compiler/aec-cc")
OBJDUMP  = os.path.join(os.path.dirname(__file__), "../disassembler/aec-objdump")
PTX_DIR  = os.path.join(os.path.dirname(__file__), "../../testcases")
REPORT_PATH = os.path.join(os.path.dirname(__file__), "agent_report.json")


def compile_ptx(ptx_path, out_path, opt="-O2"):
    r = subprocess.run([COMPILER, ptx_path, opt, "-o", out_path],
                       capture_output=True, text=True)
    return r.returncode == 0, r.stderr.strip()


def disassemble(bin_path):
    r = subprocess.run([OBJDUMP, bin_path], capture_output=True, text=True)
    return r.returncode == 0, r.stdout.strip()


def run_agent():
    ptx_files = sorted(f for f in os.listdir(PTX_DIR) if f.endswith(".ptx"))
    if not ptx_files:
        print("[Agent] No PTX files found")
        sys.exit(1)

    runs = []
    for ptx in ptx_files:
        ptx_path = os.path.join(PTX_DIR, ptx)
        stem = ptx.replace(".ptx", "")
        out_O1 = f"/tmp/{stem}_O1.aecbin"
        out_O2 = f"/tmp/{stem}_O2.aecbin"

        # Round1: O1
        ok1, err1 = compile_ptx(ptx_path, out_O1, "-O1")
        # Round 2: O2 (optimization)
        ok2, err2 = compile_ptx(ptx_path, out_O2, "-O2")
        # Verify disassembly
        disasm_ok, disasm = (False, "") if not ok2 else disassemble(out_O2)

        runs.append({
            "ptx": ptx,
            "O1_ok": ok1,
            "O2_ok": ok2,
            "disasm_ok": disasm_ok,
            "disasm_lines": len(disasm.splitlines()) if disasm else 0,
            "error": err2 if not ok2 else "",
        })
        status = "✓" if ok2 and disasm_ok else "✗"
        print(f"[{status}] {ptx}: O1={ok1} O2={ok2} disasm={disasm_ok}")

    # Generate report
    passed = sum(1 for r in runs if r["O2_ok"] and r["disasm_ok"])
    report = {
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "total": len(runs),
        "passed": passed,
        "failed": len(runs) - passed,
        "recommendation": "O2 is stable" if passed == len(runs) else "review failed cases",
        "runs": runs,
    }
    with open(REPORT_PATH, "w") as f:
        json.dump(report, f, indent=2)

    print(f"\n[Agent] {passed}/{len(runs)} passed")
    print(f"[Agent] Report: {REPORT_PATH}")
    return 0 if passed > 0 else 1


if __name__ == "__main__":
    sys.exit(run_agent())
